# touchscreen-display/Dockerfile.prod
# syntax = docker/dockerfile:1.4
########################################################
# Builder stage: install deps and build the Next app
########################################################
FROM node:20-slim AS builder
WORKDIR /app

# Make sure Next builds with production mode
ENV NODE_ENV=production

# Copy package manifests first to leverage layer caching
COPY package*.json yarn.lock* ./

# Install including devDependencies (build tools like tailwind)
RUN --mount=type=cache,target=/root/.npm \
    NPM_CONFIG_PRODUCTION=false npm ci

# Copy source and build
COPY . .

# Cache .next content between builds when rebuilds happen locally with BuildKit
RUN --mount=type=cache,target=/app/.next/cache \
    npm run build

########################################################
# Runner stage: copy only runtime artifacts
########################################################
FROM node:20-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

# Copy only what's needed at runtime (including node_modules from builder)
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 3000

CMD ["npm", "run", "start"]
